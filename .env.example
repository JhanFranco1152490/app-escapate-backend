# Copiar a .env y ajustar. Nunca commitear el .env real.

# Base de datos de desarrollo. En Railway es una referencia a la variable del servicio Postgres;
# la app acepta postgres://, postgresql:// o postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://app_escapate:app_escapate@localhost:5432/app_escapate
# Base que las pruebas crean y borran solas. El nombre tiene que terminar en _test.
TEST_DATABASE_URL=postgresql+psycopg://app_escapate:app_escapate@localhost:5432/app_escapate_test

# Mínimo 32 caracteres y distinta por entorno. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# true solo en local: publica el OpenAPI en /api/openapi.json y /api/docs.
DEBUG=true

# Origen permitido por CORS y base de los enlaces de los correos.
FRONTEND_ORIGIN=http://localhost:3000

# Proxies de confianza delante del backend: 0 en local, 1 en Railway.
TRUSTED_PROXY_COUNT=0

# En Railway: COOKIE_SECURE=true. En local va false porque no hay https.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# console imprime los correos en la terminal; resend los envía por la API de Resend.
EMAIL_BACKEND=console
EMAIL_FROM=Escápate <no-responder@example.com>
RESEND_API_KEY=

# Ingreso con Google: cliente OAuth "Aplicación web" del proyecto de Google Cloud de la
# agencia. Sin estos valores el ingreso con Google responde error y el resto funciona.
# La URI debe coincidir exactamente con una de las autorizadas en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Límites de solicitudes por IP (formato de slowapi).
RATE_LOGIN=10/minute
RATE_GOOGLE=20/minute
RATE_REFRESH=120/minute
